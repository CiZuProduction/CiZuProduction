# ============================================================
# AI Chatbot MVP — Environment Template
# Salin file ini ke .env dan isi nilai yang sesuai.
# JANGAN commit file .env ke Git.
# ============================================================

# --------------- Application ---------------
APP_ENV=development
APP_NAME=ai-chatbot-mvp
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=replace-with-a-long-random-secret-minimum-32-chars

FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
# Build-time Next.js — nilai ini akan terekspos ke browser, jangan taruh secret
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --------------- Database ---------------
POSTGRES_DB=ai_chatbot
POSTGRES_USER=ai_chatbot_app
POSTGRES_PASSWORD=replace-with-a-strong-password
# Untuk akses dari host (pgAdmin) — pakai port 5434
DATABASE_URL=postgresql+psycopg://ai_chatbot_app:replace-with-a-strong-password@localhost:5434/ai_chatbot
# URL internal Docker (dipakai oleh service 'api' di dalam Compose)
DATABASE_URL_DOCKER=postgresql+psycopg://ai_chatbot_app:replace-with-a-strong-password@postgres:5432/ai_chatbot

# --------------- Authentication ---------------
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --------------- LLM ---------------
# Pilihan: openai | local
# Untuk Ollama lokal: LLM_PROVIDER=local
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_MODEL=llama3.2

# --------------- Embedding ---------------
# Pilihan: openai | ollama
# Untuk Ollama: EMBEDDING_PROVIDER=ollama, dimensi 768
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# --------------- OCR & Ingestion ---------------
OCR_PROVIDER=paddleocr
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5

# --------------- n8n ---------------
N8N_VERSION=1.67.1
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret-for-n8n
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_BASE_URL=http://n8n:5678
N8N_API_BASE_URL=http://n8n:5678
GENERIC_TIMEZONE=Asia/Jakarta

# --------------- Storage ---------------
# Pilihan: local | minio
STORAGE_BACKEND=local
UPLOAD_DIR=/app/data/uploads
# AES-256-GCM key — generate dengan:
# python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=

# MinIO (aktifkan jika STORAGE_BACKEND=minio)
MINIO_VERSION=RELEASE.2024-11-07T00-52-20Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
S3_ENDPOINT=http://minio:9000
S3_BUCKET=ai-chatbot-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --------------- Observability ---------------
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=ai-chatbot-api
# Grafana (aktifkan dengan: docker compose --profile monitoring up -d)
GRAFANA_PASSWORD=replace-with-strong-grafana-password
